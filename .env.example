# Server-side Gemini API key (automatically injected in AI Studio)
GEMINI_API_KEY=

# Optional GitHub Personal Access Token for private repo/CLI operations
GITHUB_TOKEN=

# Optional local GGUF model override for Neo 4 (auto-discovers .folio-data/models/*.gguf)
FOLIO_TINY_LLM_MODEL=

# Optional remote OpenAI-compatible / Ollama endpoint for huge-RAM external LLMs (0 MB local RAM)
FOLIO_REMOTE_LLM_URL=
FOLIO_REMOTE_LLM_MODEL=
FOLIO_REMOTE_LLM_KEY=

